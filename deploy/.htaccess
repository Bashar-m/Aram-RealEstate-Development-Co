# ARAM website — server config for Apache / LiteSpeed (e.g. Hostinger).
# Copied into out/ by `npm run build` (postbuild step). Other hosts: see README → Deployment.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Correct types for modern assets (.mjs is required for the PDF.js module worker)
AddType text/javascript .js .mjs
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .mjs .txt .xml .json

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical address: www → https://aram-construction.com
  RewriteCond %{HTTP_HOST} ^www\.aram-construction\.com$ [NC]
  RewriteRule ^ https://aram-construction.com%{REQUEST_URI} [L,R=301]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Hide dotfiles (except /.well-known/ for SSL validation)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # "/" → default (Arabic) site; the page itself also has a meta-refresh fallback
  RewriteRule ^$ /ar/ [L,R=302]

  # Mark content-hashed build assets for long-term caching
  RewriteRule ^_next/static/ - [E=ARAM_IMMUTABLE:1]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # The site loads nothing from other origins. 'unsafe-inline' is required by
  # the Next.js static export (inline bootstrap scripts, inline style attributes).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By

  # Caching: pages revalidate, hashed assets are immutable, media for 30 days
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ARAM_IMMUTABLE
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
